# Peach Salon & Atelier - Backend Environment Configuration

PORT=5000
NODE_ENV=development
OWNER_PASSCODE=eshivi

# --- FIREBASE FIRESTORE CLOUD CONFIGURATION ---
# Option 1: Provide full Service Account JSON as a single-line string
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"peach-salon-atelier",...}

# Option 2: Provide individual Firebase Project credentials
# FIREBASE_PROJECT_ID=peach-salon-atelier
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@peach-salon-atelier.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option 3: Place your 'serviceAccountKey.json' directly in the 'server/' directory.
# (If no cloud keys are present, the backend automatically uses the high-performance local file-backed Firestore store)
